# Copy this file to .env and adjust values for your environment.
# .env is gitignored and must never be committed.

# PostgreSQL credentials — used by both the postgres container and the app
DB_USERNAME=keynor
DB_PASSWORD=keynor

# OAuth2 issuer URI — must match the host where keynor-core is reachable
# Local (app runs outside Docker):  http://localhost:8080
# Full Docker Compose (app profile): http://localhost:8080
OAUTH2_ISSUER_URI=http://localhost:8080

# OAuth2 SYSTEM client credentials — used by agents to obtain tokens via client_credentials
KEYNOR_OAUTH_CLIENT_ID=system-client
KEYNOR_OAUTH_CLIENT_SECRET=r4nd0m-s3-cr3-t
KEYNOR_OAUTH_TOKEN_URL=http://localhost:8080/oauth2/token
